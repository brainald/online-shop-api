# Copy this file to `.env` and replace all placeholders with local values.

# PostgreSQL connection string.
# Requires a running PostgreSQL server and an existing database.
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# Server port. Defaults to 3000 when omitted.
PORT=3000

# Runtime environment. Enables verbose Prisma logging in development.
NODE_ENV=development

# Secret used to sign and verify access tokens.
# Use a long, random value and never commit the real secret.
JWT_SECRET="replace-with-a-long-random-access-token-secret"

# Access-token lifetime in seconds. 900 seconds = 15 minutes.
JWT_EXPIRES_IN=900

# Secret used to sign and verify refresh tokens.
# Keep this different from JWT_SECRET.
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-token-secret"

# Refresh-token lifetime in seconds. 604800 seconds = 7 days.
JWT_REFRESH_EXPIRES_IN=604800

# Stripe secret key: is a server-side credential used to authenticate your backend code
# and perform sensitive actions like creating charges, issuing refunds, and managing customer data
STRIPE_SECRET_KEY=sk_test_436kl24562F435tTREgrGET4535GDFGrtRE236426546DSG543543631SDsh